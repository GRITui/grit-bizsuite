// Prisma schema — Ecommerce Order-Fulfillment / Inventory / Delivery Platform
// Milestone 1 (admin-only ops tool). See docs/ecommerce-stack-handoff.md for the full spec.
//
// Note on multi-tenancy: every domain table carries a `tenantId`, and a nullable
// `storeId` is present from day one (see Store/User/Order/Delivery/StockMovement)
// so Milestone 2's move to non-nullable, fully store-scoped stock does not
// require a destructive migration.
//
// Bundle / BundleComponent below are stubbed now (unused by any M1 code path)
// per the handoff so Milestone 2 (build-to-sell bundles) doesn't require a
// destructive migration either.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum OrderStatus {
  pending
  paid
  fulfilling
  fulfilled
  cancelled
}

enum DeliveryStatus {
  assigned
  out_for_delivery
  delivered
  failed
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  other
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum StockMovementReason {
  manual_adjustment
  order_fulfillment
  restock
  return
  correction
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores   Store[]
  users    User[]
  products Product[]
  variants Variant[]
  orders   Order[]
  bundles  Bundle[]
}

/// Single row for M1. Structurally present so M2 multi-store doesn't require
/// a schema break — see handoff Section 4.1.
model Store {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  orders         Order[]
  deliveries     Delivery[]
  stockMovements StockMovement[]

  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated Order[] @relation("OrderCreatedBy")

  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants Variant[]

  @@index([tenantId])
}

/// quantityOnHand lives directly on Variant for M1 (single store). M2 moves
/// it off Variant onto a per-store StoreStock join table — see handoff 4.1.
model Variant {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String
  name             String
  price            Decimal  @db.Decimal(12, 2)
  quantityOnHand   Int      @default(0)
  reorderThreshold Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockMovements    StockMovement[]
  orderLines        OrderLine[]
  bundleComponents  BundleComponent[]
  forecastSnapshots ForecastSnapshot[]
  deadStockFlags    DeadStockFlag[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
}

/// Append-only audit trail. Every stock change (manual edit, order
/// fulfillment, restock, bundle component decrement) writes one row here.
model StockMovement {
  id          String              @id @default(cuid())
  tenantId    String
  storeId     String?
  store       Store?              @relation(fields: [storeId], references: [id])
  variantId   String
  variant     Variant             @relation(fields: [variantId], references: [id])
  delta       Int
  reason      StockMovementReason
  orderLineId String?
  orderLine   OrderLine?          @relation(fields: [orderLineId], references: [id])
  bundleId    String?
  bundle      Bundle?             @relation(fields: [bundleId], references: [id])
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([tenantId, variantId])
  @@index([storeId])
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  storeId         String?
  store           Store?      @relation(fields: [storeId], references: [id])
  orderNumber     String
  status          OrderStatus @default(pending)
  customerName    String?
  customerPhone   String?
  customerAddress String?
  notes           String?
  createdById     String?
  createdBy       User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines    OrderLine[]
  payments Payment[]
  delivery Delivery?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([storeId])
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id])
  bundleId    String?
  bundle      Bundle?  @relation(fields: [bundleId], references: [id])
  description String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  createdAt   DateTime @default(now())

  stockMovements StockMovement[]

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  status    PaymentStatus @default(pending)
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@index([orderId])
}

/// Manual staff-updated statuses for M1. courierName/externalTrackingId are
/// present unused so a future courier webhook integration doesn't need a
/// schema break — see handoff Section 6.
model Delivery {
  id                 String         @id @default(cuid())
  tenantId           String
  storeId            String?
  store              Store?         @relation(fields: [storeId], references: [id])
  orderId            String         @unique
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status             DeliveryStatus @default(assigned)
  assignedTo         String?
  address            String?
  courierName        String?
  externalTrackingId String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  statusHistory DeliveryStatusEvent[]

  @@index([tenantId, status])
}

model DeliveryStatusEvent {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     DeliveryStatus
  note       String?
  createdAt  DateTime       @default(now())

  @@index([deliveryId])
}

model ForecastSnapshot {
  id                  String   @id @default(cuid())
  tenantId            String
  variantId           String
  variant             Variant  @relation(fields: [variantId], references: [id])
  periodStart         DateTime
  periodEnd           DateTime
  method              String
  forecastQty         Decimal  @db.Decimal(12, 2)
  suggestedReorderQty Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([tenantId, variantId, periodStart])
}

model DeadStockFlag {
  id                String    @id @default(cuid())
  tenantId          String
  variantId         String
  variant           Variant   @relation(fields: [variantId], references: [id])
  reason            String
  daysSinceLastSale Int
  quantityOnHand    Int
  flaggedAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([tenantId, variantId])
}

// --- Stubbed for M2 (build-to-sell bundles) — see handoff Section 4.2. ---
// Unused by any M1 code path. A Bundle never holds its own stock; sellable
// quantity is always derived from its components at read time.

model Bundle {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sku       String
  name      String
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components     BundleComponent[] @relation("BundleComponents")
  usedInBundles  BundleComponent[] @relation("BundleOfBundles")
  orderLines     OrderLine[]
  stockMovements StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

/// componentVariantId XOR componentBundleId (enforced at app level) so a
/// component can be a leaf Variant or another Bundle (bundle-of-bundles),
/// resolved recursively to leaf variants at availability/decrement time.
model BundleComponent {
  id                 String   @id @default(cuid())
  bundleId           String
  bundle             Bundle   @relation("BundleComponents", fields: [bundleId], references: [id], onDelete: Cascade)
  componentVariantId String?
  componentVariant   Variant? @relation(fields: [componentVariantId], references: [id])
  componentBundleId  String?
  componentBundle    Bundle?  @relation("BundleOfBundles", fields: [componentBundleId], references: [id])
  qtyRequired        Int

  @@index([bundleId])
}
