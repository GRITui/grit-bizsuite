{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "npx prisma migrate deploy && cd ../.. && npm run build --workspace=invento",
  "outputDirectory": ".next",
  "crons": [
    { "path": "/api/cron/restock-alert", "schedule": "0 8 * * *" },
    { "path": "/api/cron/forecast-recompute", "schedule": "0 2 * * *" },
    { "path": "/api/cron/dead-stock-scan", "schedule": "30 2 * * *" },
    { "path": "/api/cron/events-drain", "schedule": "0 3 * * *" }
  ]
}
