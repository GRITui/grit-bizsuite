# Copy this file to .env and fill in a real Neon Postgres connection string.
# Never commit .env — only this .env.example template is tracked in git.
#
# Neon Postgres connection string (pooled, for use with Prisma).
# Get yours from the Neon console: https://console.neon.tech
DATABASE_URL="postgresql://neon_user:REPLACE_ME_FAKE_PASSWORD@ep-example-000000.us-east-2.aws.neon.tech/grit_manpower?sslmode=require"

# Secret used to sign this app's own legacy staff session JWTs (HS256).
# Generate a strong random value, e.g.: openssl rand -base64 32
#
# Also used as the FALLBACK secret for the shared grit_passport cookie (see
# GRIT_SESSION_SECRET below) when that var is unset — @grit/passport's
# getSessionSecret() tries GRIT_SESSION_SECRET first, then this. Set
# GRIT_SESSION_SECRET explicitly (to the value every other Grit app uses)
# rather than relying on that fallback once this app is deployed alongside
# the others, so this value can stay manpower-local.
SESSION_SECRET="REPLACE_ME_FAKE_SESSION_SECRET"

# Secret used to sign the shared grit_passport session JWT (HS256) via
# @grit/passport. Every Grit app must share the SAME value for SSO to work.
# Generate a strong random value, e.g.: openssl rand -base64 32
GRIT_SESSION_SECRET="REPLACE_ME_FAKE_GRIT_SESSION_SECRET"

# ---------------------------------------------------------------------------
# Grit BizSuite integration (ALL OPTIONAL — leave unset to run standalone;
# event publishing simply stays inert).
# ---------------------------------------------------------------------------

# Shared HMAC secret for @grit/shared-events internal webhooks.
#GRIT_EVENT_WEBHOOK_SECRET="REPLACE_ME_SHARED_EVENT_SECRET"

# Comma-separated subscriber URLs notified on manpower.shift_unassigned
# (published whenever a Shift is created/updated with no employee assigned —
# Taskboard turns this into an ops card).
#GRIT_SUBSCRIBERS_MANPOWER_SHIFT_UNASSIGNED="http://localhost:3002/api/grit-events"
