<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required under Electron's hardened runtime for the main process to
       spawn the bundled Postgres binary + the 5 app child processes, and
       for JIT (V8) to function at all. Needed even for an UNSIGNED/
       ad-hoc-signed build once hardenedRuntime is on — see
       electron-builder.yml's mac.hardenedRuntime note on when this
       actually gets exercised. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Network: the 5 app servers + Postgres all listen on 127.0.0.1 only,
       but Next.js/Node still opens real sockets, which needs this. -->
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
