{
  "name": "grit-bizsuite-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native macOS packaging for Grit BizSuite — bundles Postgres + all 5 apps behind an Electron process supervisor.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-renderer",
    "copy-renderer": "mkdir -p dist/renderer && cp -R src/renderer/* dist/renderer/",
    "dev": "npm run build && electron .",
    "prepare-resources": "bash scripts/build-resources.sh",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "^8.13.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
