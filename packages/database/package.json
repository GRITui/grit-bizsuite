{
  "name": "@grit/database",
  "version": "0.1.0",
  "private": true,
  "description": "Grit BizSuite centralized shared schema: SQL migrations, Prisma 7 schema/client, Neon outbox store, and demo seed data.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./outbox": "./dist/outbox.js",
    "./client": "./dist/generated/client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "seed"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@grit/shared-events": "*",
    "@neondatabase/serverless": "^1.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0",
    "typescript": "^5"
  }
}
