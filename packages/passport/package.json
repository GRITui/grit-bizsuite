{
  "name": "@grit/passport",
  "version": "0.1.0",
  "private": true,
  "description": "Grit Passport: shared SSO session contract (jose HS256 JWT cookie), role-based access control, and commercial-tier feature gating for the Grit BizSuite apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./session": "./dist/session.js",
    "./rbac": "./dist/rbac.js",
    "./entitlements": "./dist/entitlements.js",
    "./nav": "./dist/nav.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
