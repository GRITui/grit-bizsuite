{
  "name": "@grit/shared-events",
  "version": "0.1.0",
  "private": true,
  "description": "Grit BizSuite inter-app event layer: event contracts, HMAC-signed internal webhooks, and a durable outbox-backed event bus.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./contracts": "./dist/contracts.js",
    "./webhook": "./dist/webhook.js",
    "./bus": "./dist/bus.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
