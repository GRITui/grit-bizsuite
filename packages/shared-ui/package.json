{
  "name": "@grit/shared-ui",
  "version": "0.1.0",
  "private": true,
  "description": "GRITui — shared React component library for the Grit BizSuite apps. Tailwind v4 utility classes only, ships pre-compiled JS + type declarations built from TypeScript source.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./Button": "./dist/Button.js",
    "./Input": "./dist/Input.js",
    "./Table": "./dist/Table.js",
    "./Panel": "./dist/Panel.js",
    "./Badge": "./dist/Badge.js",
    "./EmptyState": "./dist/EmptyState.js",
    "./AppSwitcher": "./dist/AppSwitcher.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^19"
  }
}
